# ============================================================
# 🔹 FUNÇÃO PARA CARREGAR O DICIONÁRIO LIWC
# ============================================================
def load_liwc_pt(dic_path):
    categories = {}
    dictionary = {}

    # Remove BOM automaticamente com utf-8-sig
    with open(dic_path, "r", encoding="utf-8-sig") as f:
        lines = f.readlines()

    mode = None

    for line in lines:
        line = line.strip()
        if not line:
            continue

        # Blocos começam com %
        if line.startswith("%"):
            if mode is None:
                mode = "categories"
            else:
                mode = "words"
            continue

        # ----- CATEGORIAS -----
        if mode == "categories":
            parts = line.split()
            if len(parts) >= 2:
                cat_id = parts[0]
                cat_name = parts[1]
                categories[cat_id] = cat_name

        # ----- PALAVRAS → CATEGORIAS -----
        elif mode == "words":
            parts = line.split()
            word = parts[0].lower()
            cats = parts[1:]
            dictionary[word] = cats

    return categories, dictionary


# ============================================================
# 🔹 TESTE
# ============================================================
categories, dictionary = load_liwc_pt(dic_path)

print("Categorias carregadas:", len(categories))
print("Palavras carregadas:", len(dictionary))
